generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  MORADOR
  FUNCIONARIO
  SINDICO
}

model Usuario {
  cpf   String @id @db.Char(11)
  senha String
  papel Papel

  morador     Morador?
  funcionario Funcionario?
  sindico     Sindico?
}

model Morador {
  cpf      String @id @db.Char(11)
  nome     String
  telefone String @db.Char(11)

  usuario Usuario @relation(fields: [cpf], references: [cpf])

  ordens OrdemServico[]
}

model Funcionario {
  cpf      String @id @db.Char(11)
  nome     String
  telefone String @db.Char(11)

  usuario Usuario @relation(fields: [cpf], references: [cpf])

  ordensExecutadas OrdemServico[]
}

model Sindico {
  cpf_sindico String @id @db.Char(11)

  usuario Usuario @relation(fields: [cpf_sindico], references: [cpf])

  ordensAprovadas OrdemServico[]
}

model OrdemServico {
  id            Int       @id @default(autoincrement())
  descricao     String
  dataAbertura  DateTime  @default(now())
  dataConclusao DateTime?
  status        String    @default("ABERTA")
  aprovado      Boolean   @default(false)

  cpf_morador String
  morador     Morador @relation(fields: [cpf_morador], references: [cpf])

  cpf_sindico String?
  sindico     Sindico? @relation(fields: [cpf_sindico], references: [cpf_sindico])

  cpf_funcionario String?
  executor        Funcionario? @relation(fields: [cpf_funcionario], references: [cpf])
}
